[Unit]
Description=Rifa Bolimangus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bolimangus
Group=bolimangus
WorkingDirectory=/opt/bolimangus
Environment=NODE_ENV=production
EnvironmentFile=/etc/bolimangus/bolimangus.env
ExecStart=/usr/local/bin/node /opt/bolimangus/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0027

# Endurecimiento compatible con Node.js.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/bolimangus
LimitNOFILE=4096
MemoryMax=384M

[Install]
WantedBy=multi-user.target
