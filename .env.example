# Red y proceso
HOST=127.0.0.1
PORT=3000

# Genere ambos valores con: pnpm create-secrets
ADMIN_PASSWORD_HASH=scrypt$reemplace_este_valor
SESSION_SECRET=reemplace_con_un_secreto_de_64_caracteres_o_mas

# Use true cuando la pagina final funcione exclusivamente con HTTPS.
COOKIE_SECURE=false
HTTPS_ONLY=false

# Normalmente no necesita modificar estas rutas.
DATA_FILE=./data/rifa.json
UPLOAD_DIR=./public/uploads
TEMP_UPLOAD_DIR=./data/temp-uploads
